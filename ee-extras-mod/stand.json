{
  "chains": {
    "pcb-input-restart": {
      "note": "#315: внешние делители и параллельные входы микросхем, сохранение, перезапуск и вход клиентом",
      "steps": [
        {
          "name": "build",
          "kind": "server",
          "cmd": [
            "forceload add 192 192 240 224",
            "setworldspawn 202 -59 198",
            "sleep 10",
            "pcbinput matrix",
            "sleep 15",
            "pcbinput matrix-check",
            "save-all flush"
          ],
          "failFast": true,
          "expect": [
            "Матрица входов 0: 2\\.[45]",
            "Матрица входов 1: 2\\.[45]",
            "Матрица входов 2: 2\\.[45]",
            "Матрица входов 3: 2\\.[45]",
            "Матрица входов 4: 2\\.[45]",
            "Матрица входов 5: 2\\.[45]",
            "Матрица входов 6: 2\\.[45]",
            "Матрица входов 7: 2\\.[45]"
          ],
          "save": true
        },
        {
          "name": "restart",
          "kind": "server",
          "world": "build",
          "cmd": ["sleep 15", "pcbinput matrix-check"],
          "failFast": true,
          "expect": [
            "Матрица входов 0: 2\\.[45]",
            "Матрица входов 1: 2\\.[45]",
            "Матрица входов 2: 2\\.[45]",
            "Матрица входов 3: 2\\.[45]",
            "Матрица входов 4: 2\\.[45]",
            "Матрица входов 5: 2\\.[45]",
            "Матрица входов 6: 2\\.[45]",
            "Матрица входов 7: 2\\.[45]"
          ],
          "save": true
        },
        {
          "name": "client",
          "kind": "client",
          "world": "restart",
          "shots": 2
        }
      ]
    },
    "pcb-name-restart": {
      "note": "#301.29: имя проекта в редакторе, чертеже и собранной плате после перезапуска",
      "steps": [
        {
          "name": "build",
          "kind": "server",
          "levelType": "minecraft:flat",
          "cmd": ["forceload add 0 0 95 159", "sleep 3", "pcbextra prepare-restart"],
          "failFast": true,
          "expect": [
            "Имя проекта: сервер/чужое меню/устаревший запрос/лимит/отмена/повтор/предмет/NBT/загрузка — успешно",
