  "chains": {
    "rectifier-restart": {
      "note": "выпрямители EE Extras: сборка и замер → рестарт на сохранённом мире → вход клиентом",
      "steps": [
        {
          "name": "build",
          "kind": "server",
          "cmd": [
            "forceload add 0 0 32 32",
            "rectest build",
            "sleep 3",
            "rectest power 10",
            "sleep 15",
            "rectest report"
          ],
          "failFast": true,
          "expect": [
            "трёхфазный: на выходе [1-9][.,][0-9]+ В[^\\n]*; батарея 10[.,]0 В, частота 1[.,]0[^\\n]*однофазный:[^\\n]*; батарея 10[.,]0 В, частота 1[.,]0"
          ],
          "save": true
        },
        {
          "name": "restart",
          "kind": "server",
          "world": "build",
          "cmd": [
            "sleep 15",
            "execute if block 2 -60 13 ee_extras:three_phase_rectifier",
            "execute if block 2 -60 23 ee_extras:single_phase_rectifier",
            "execute if block 4 -60 16 electroenergetics:voltmeter",
            "rectest report"
          ],
          "failFast": true,
          "failOn": ["Test failed"],
          "expect": [
            "Test passed[\\s\\S]*Test passed[\\s\\S]*Test passed",
            "трёхфазный: на выходе [1-9][.,][0-9]+ В[^\\n]*; батарея 10[.,]0 В, частота 1[.,]0[^\\n]*однофазный:[^\\n]*; батарея 10[.,]0 В, частота 1[.,]0"
          ],
          "save": true
        },
        {
          "name": "client",
          "kind": "client",
          "world": "restart",
          "shots": 2,
          "save": true
        }
      ]
    },
    "battery-persistence": {
      "note": "четыре творческие батареи EE и два преобразователи EE Extras: проверка настроек после двух рестартов",
      "steps": [
        {
          "name": "configure",
          "kind": "server",
          "cmd": [
            "forceload add 0 0 32 32",
            "eepersist place",
            "sleep 3",
            "eepersist configure",
            "sleep 3",
            "eepersist check"
          ],
          "failFast": true,
          "expect": ["Настройки сохранены"],
          "save": true
        },
        {
          "name": "restart-1",
          "kind": "server",
          "world": "configure",
          "cmd": ["sleep 3", "eepersist check"],
          "failFast": true,
          "expect": ["Настройки сохранены"],
          "save": true
        },
        {
          "name": "restart-2",
          "kind": "server",
          "world": "restart-1",
          "cmd": ["sleep 3", "eepersist check"],
          "failFast": true,
          "expect": ["Настройки сохранены"]
        }
      ]
    },
    "pcb-restart": {
      "note": "плата EE Extras: установка на сервере (мир tfc:overworld — сцене нужен он) → рестарт на сохранённом мире → сцена pcb-world снимает плату в этом мире",
      "steps": [
        {
          "name": "mount",
          "kind": "server",
          "levelType": "tfc:overworld",
          "timeout": 1200,
          "cmd": ["pcbmount"],
          "failFast": true,
          "expect": ["PCB MOUNT PASS"],
          "failOn": ["PCB MOUNT FAIL"],
          "save": true
        },
        {
          "name": "restart",
          "kind": "server",
          "world": "mount",
          "cmd": ["sleep 10", "pcbcheck"],
          "failFast": true,
          "expect": ["PCB MOUNT PASS"],
          "failOn": ["PCB MOUNT FAIL"],
          "save": true
        },
        {
          "name": "photo",
          "kind": "client",
          "world": "restart",
          "scene": "pcb-world"
        }
      ]
    },
    "line-spans": {
      "note": "#399: перемычки до и после натяжения, запрет второго анкера, независимое снятие",
      "steps": [
        {
          "name": "server",
          "kind": "server",
          "cmd": [
            "forceload add 0 0 48 80",
            "rectest anchors selection",
            "rectest anchors build",
            "sleep 3",
            "rectest anchors clamp",
            "sleep 5",
            "rectest anchors check",
            "rectest anchors power",
            "sleep 5",
            "rectest anchors check",
            "rectest anchors voltage",
            "rectest anchors chainbuild",
            "sleep 5",
            "rectest anchors chaincheck",
            "sleep 3",
            "rectest anchors chaincheck",
            "rectest anchors chainrelease",
            "sleep 5",
            "rectest anchors chainreleased"
          ],
          "failFast": true,
          "expect": ["ВЫБОР ГИРЛЯНД ОК", "ПРОЛЁТ ОК", "ПИТАНИЕ ОК", "ЦЕПОЧКА ОК", "НЕЗАВИСИМОЕ СНЯТИЕ ОК"],
          "failOn": ["ОШИБКА"]
        }
      ]
    }
  }
