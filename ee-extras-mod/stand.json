{
  "scenes": {
    "insulator-anchors": {
      "shots": ["free-suspension", "anchored-span"]
    },
    "wall-disconnect": {
      "shots": ["disconnect-closed", "disconnect-open"]
    },
    "integrated-drives": {
      "shots": ["belt-before", "belt-drive", "auger-drive"]
    },
    "electric-press": {
      "shots": ["electric-press"]
    },
    "electric-machines": {
      "shots": ["electric-machines", "fluid-dispenser"]
    }
  },
  "chains": {
    "rectifier-restart": {
      "note": "выпрямители EE Extras: сборка и замер → рестарт на сохранённом мире → вход клиентом",
      "steps": [
        {
          "name": "build",
          "kind": "server",
          "cmd": [
            "forceload add 0 0 32 32",
            "rectest build",
            "sleep 3",
            "rectest power 10",
            "sleep 15",
            "rectest report"
          ],
          "failFast": true,
          "expect": [
            "трёхфазный: на выходе [1-9][.,][0-9]+ В[^\\n]*; батарея 10[.,]0 В, частота 1[.,]0[^\\n]*однофазный:[^\\n]*; батарея 10[.,]0 В, частота 1[.,]0"
          ],
          "save": true
        },
        {
          "name": "restart",
          "kind": "server",
          "world": "build",
          "cmd": [
            "sleep 15",
            "execute if block 2 -60 13 ee_extras:three_phase_rectifier",
            "execute if block 2 -60 23 ee_extras:single_phase_rectifier",
            "execute if block 4 -60 16 electroenergetics:voltmeter",
            "rectest report"
          ],
          "failFast": true,
          "failOn": ["Test failed"],
          "expect": [
            "Test passed[\\s\\S]*Test passed[\\s\\S]*Test passed",
            "трёхфазный: на выходе [1-9][.,][0-9]+ В[^\\n]*; батарея 10[.,]0 В, частота 1[.,]0[^\\n]*однофазный:[^\\n]*; батарея 10[.,]0 В, частота 1[.,]0"
          ],
          "save": true
        },
        {
          "name": "client",
          "kind": "client",
          "world": "restart",
          "shots": 2,
          "save": true
        }
      ]
    },
    "battery-persistence": {
      "note": "четыре творческие батареи EE и два преобразователя EE Extras: проверка настроек после двух рестартов",
      "steps": [
        {
          "name": "configure",
          "kind": "server",
          "cmd": [
            "forceload add 0 0 32 32",
            "eepersist place",
            "sleep 3",
            "eepersist configure",
            "sleep 3",
            "eepersist check"
          ],
          "failFast": true,
          "expect": ["Настройки сохранены"],
          "save": true
        },
        {
          "name": "restart-1",
          "kind": "server",
          "world": "configure",
          "cmd": ["sleep 3", "eepersist check"],
          "failFast": true,
          "expect": ["Настройки сохранены"],
          "save": true
        },
        {
          "name": "restart-2",
          "kind": "server",
          "world": "restart-1",
          "cmd": ["sleep 3", "eepersist check"],
          "failFast": true,
          "expect": ["Настройки сохранены"]
        }
      ]
    }
  }
}
